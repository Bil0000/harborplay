+/// Capture input that stopped this long ago counts as missing.
+const CAPTURE_INPUT_GAP: Duration = Duration::from_millis(100);
+
+/// Pump state of a capture stream without input: when the ring last grew, and since when the
+/// guest gets silence and how much of it.
+#[derive(Default)]
+struct SilentCapture {
+    written: u64,
+    input_at: Option<Instant>,
+    since: Option<(Instant, u64)>,
+}
+
+/// Capture without input (no microphone, permission denied, a start stuck in HAL that holds
+/// the stream): complete the guest's reads with silence at the stream's rate, without the
+/// stream's lock. A read that never completes fails in the guest with EIO, and its sound
+/// server then stops. Real input takes over once the device delivers. Returns when to come back.
+fn fill_silent_capture(inner: &Inner, id: usize, state: &mut SilentCapture) -> Option<Duration> {
+    let shared = &inner.shared[id];
+    let now = Instant::now();
+    let written = shared.ring.written();
+    if written != state.written {
+        state.written = written;
+        state.input_at = Some(now);
+    }
+    let live = state.input_at.is_some_and(|at| now - at < CAPTURE_INPUT_GAP);
+    if live || !shared.running.load(Ordering::Acquire) {
+        state.since = None;
+        return None;
+    }
+    let mut streams = inner.streams.write().unwrap();
+    let guest = &mut streams[id];
+    let fmt = Format::from_params(&guest.params)?;
+    let fb = fmt.frame_bytes() as u128;
+    let (start, sent) = state.since.get_or_insert((now, 0));
+    let due = ((now - *start).as_nanos() * fmt.rate as u128 / 1_000_000_000 * fb) as u64;
+    if guest.buffers.is_empty() {
+        // The guest is not reading: owe it nothing for that time.
+        *sent = due;
+    }
+    let silence = [fmt.silence(); 4096];
+    while *sent < due {
+        let Some(buf) = guest.buffers.front_mut() else { break };
+        let space = (buf.desc_len() as usize).saturating_sub(buf.pos);
+        let n = space.min((due - *sent) as usize).min(silence.len());
+        if n > 0 {
+            match buf.write_input(&silence[..n]) {
+                Ok(len) => *sent += len as u64,
+                Err(_) => {
+                    buf.message.status.store(VIRTIO_SND_S_IO_ERR, Ordering::SeqCst);
+                    buf.pos = buf.desc_len() as usize;
+                }
+            }
+        }
+        if buf.pos >= buf.desc_len() as usize {
+            let buf = guest.buffers.pop_front().unwrap();
+            buf.message.latency_bytes.store(0, Ordering::Relaxed);
+        }
+    }
+    Some(Duration::from_millis(5))
+}
