+    /// Capture reads complete with silence while no input arrives, also while a start stuck in
+    /// HAL holds the stream past the watchdog's limit. (Before: they stayed queued until the
+    /// watchdog failed them with IO_ERR, the guest's read returned EIO, and PipeWire stopped.)
+    #[test]
+    fn capture_without_input_completes_reads_with_silence() {
+        let mut stream = Stream::default();
+        stream.direction = Direction::Input;
+        stream.params.rate = VIRTIO_SND_PCM_RATE_48000;
+        stream.params.channels = 2;
+        stream.state = PCMState::Start;
+        let streams = Arc::new(RwLock::new(vec![stream]));
+        let backend = Arc::new(
+            CoreAudioBackend::with_deadlines(streams, Arc::new(SndControl::default()), CTL, STALL)
+                .unwrap(),
+        );
+        backend.inner.shared[0].running.store(true, Ordering::Release);
+        let _stuck = StuckPump::new(&backend);
+        std::thread::sleep(STALL * 2);
+        let mem = GuestMemoryMmap::<()>::from_ranges(&[(GuestAddress(0), 0x1000)]).unwrap();
+        mem.write_slice(&[0xaa; 1920], GuestAddress(0x400)).unwrap();
+        let interrupt =
+            InterruptTransport::new(DummyIrqChip::new().into(), "snd-test".into()).unwrap();
+        let message = Arc::new(IOMessage {
+            status: AtomicU32::new(VIRTIO_SND_S_OK),
+            used_len: 0.into(),
+            latency_bytes: 0.into(),
+            head_index: 0,
+            response_descriptor: Descriptor { addr: 0x100, len: 8, flags: 0, next: 0 },
+            vring: Arc::new(Mutex::new(Vring { mem: mem.clone(), queue: Queue::new(16), interrupt })),
+        });
+        // 5 ms of 48 kHz stereo S16.
+        let desc = Descriptor { addr: 0x400, len: 1920, flags: 0, next: 0 };
+        backend.inner.streams.write().unwrap()[0]
+            .buffers
+            .push_back(Buffer::new(desc, message.clone(), Direction::Input));
+        let start = Instant::now();
+        backend.read(0).unwrap();
+        wait_for("silence to complete the read", Duration::from_secs(1), || {
+            completed(&message)
+        });
+        assert!(start.elapsed() >= Duration::from_millis(4), "silence is paced");
+        assert_eq!(message.status.load(Ordering::SeqCst), VIRTIO_SND_S_OK);
+        assert_eq!(message.used_len.load(Ordering::SeqCst), 1920);
+        let mut data = [0xaau8; 1920];
+        mem.read_slice(&mut data, GuestAddress(0x400)).unwrap();
+        assert!(data.iter().all(|&b| b == 0));
+    }
+
     /// An idle but healthy pump (it only wakes every HOUSEKEEPING) is not mistaken for a stuck
     /// one.
     #[test]
