#!/bin/bash
# harborplay: return the boot's page cache to the Mac, once (harborplay-mem-trim.timer, 150 s after boot).
#
# Booting SteamOS and starting the Steam client leave ~3 GiB of clean page cache in the guest. The
# guest frees memory to the Mac through virtio-balloon free page reporting, and since libkrun patch
# 0026 the Mac really gets reported pages back (they leave the VM's phys_footprint), but page cache
# is not free memory, so it is never reported. Dropping the clean page cache once, after boot has
# settled, frees it: ~1.7 GiB less VM footprint at idle (audit numbers in the commit). Re-reads are
# served from the Mac's own file cache of the disk image. It runs once per boot. If a game is running
# then (an app-steam-app*.scope below the user manager, as guest/progress-agent/src/freeze.rs finds
# them), it skips the drop and exits 75; the service then runs it again 5 minutes later, so a loading
# game never loses its page cache.
#
# Default on; harborplay.mem_trim=0 on the kernel command line turns it off.
# Test overrides: HARBORPLAY_CMDLINE, HARBORPLAY_DROP_CACHES, HARBORPLAY_MEMINFO, HARBORPLAY_CGROUP.
set -euo pipefail

cmdline=${HARBORPLAY_CMDLINE:-/proc/cmdline}
drop=${HARBORPLAY_DROP_CACHES:-/proc/sys/vm/drop_caches}
meminfo=${HARBORPLAY_MEMINFO:-/proc/meminfo}

for w in $(cat "$cmdline" 2>/dev/null); do
    case $w in harborplay.mem_trim=0) echo "mem-trim: off (harborplay.mem_trim=0)"; exit 0 ;; esac
done

cgroup=${HARBORPLAY_CGROUP:-/sys/fs/cgroup/user.slice}
game=$(find "$cgroup" -maxdepth 8 -type d -name 'app-steam-app*.scope' -path '*/user@*.service/*' -print -quit 2>/dev/null)
if [[ -n $game ]]; then
    echo "mem-trim: a game is running (${game##*/}); trying again later"
    exit 75
fi

free_kib() { awk '/^MemFree:/ { print $2 }' "$meminfo"; }
before=$(free_kib)
# 1 = clean page cache only: dirty pages, anonymous memory and slab stay untouched.
echo 1 > "$drop"
after=$(free_kib)
echo "mem-trim: dropped clean page cache, MemFree ${before} -> ${after} KiB"
