# harborplay: the guest's gamepad (player 1's; harbor-pad@.service has the further
# players'). The launcher reads the Mac's controller and
# drives this service over the virtio-console port harbor.pad; the service owns the
# pad as a uinput device (identity and capabilities of the real controller's
# kernel driver, created and removed as controllers come and go) and sends the
# pad's rumble back. See guest/progress-agent/src/pad.rs.
# Started by udev when the port appears (70-harbor-progress.rules); launchers
# without it have no such port and never start it.
[Unit]
Description=HarborPlay gamepad
ConditionPathExists=/dev/virtio-ports/harbor.pad

[Service]
Type=simple
ExecStart=/usr/lib/harborplay/harbor-progress-agent pad
Restart=on-failure
RestartSec=2
# Root opens the root-only /dev/uinput and port by their mode bits: no capabilities.
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
