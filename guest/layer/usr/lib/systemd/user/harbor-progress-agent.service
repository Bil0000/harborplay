# harborplay: guest side of the HarborPlay boot/shutdown overlay.
# Reports session -> Steam client update -> Steam UI ready, and the shutdown
# kind, over /dev/virtio-ports/harbor.progress (see
# guest/progress-agent/src/main.rs for the protocol and lifecycle).
# Pulled in by gamescope-session.target and plasma-session.target (Desktop
# Mode) through .wants symlinks in the layer; stops with either, so it receives
# SIGTERM when the session is torn down.
[Unit]
Description=HarborPlay progress reporter
PartOf=gamescope-session.target plasma-session.target
# DISPLAY is imported into the user manager by gamescope-onready before
# gamescope-session.service reports ready.
After=gamescope-session.service

[Service]
Type=simple
Slice=session.slice
ExecStart=/usr/lib/harborplay/harbor-progress-agent
# Exits 0 by itself when the launcher has no harbor.progress port.
Restart=on-failure
RestartSec=2
# The agent answers SIGTERM within ~1.5 s worst case; never hold up shutdown.
TimeoutStopSec=3
Nice=5
