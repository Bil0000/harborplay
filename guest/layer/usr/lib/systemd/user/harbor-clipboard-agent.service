# harborplay: the clipboard shared with the Mac (HarborPlay Settings >
# General "Share clipboard with SteamOS"). Owns and watches CLIPBOARD on every
# gamescope Xwayland and, in Desktop Mode, the Plasma session's Wayland
# clipboard; talks to the launcher over /dev/virtio-ports/harbor.clipboard (see
# guest/progress-agent/src/clipboard.rs).
# Pulled in by gamescope-session.target and plasma-session.target through
# .wants symlinks in the layer; stops with either.
[Unit]
Description=HarborPlay shared clipboard
PartOf=gamescope-session.target plasma-session.target
After=gamescope-session.service

[Service]
Type=simple
Slice=session.slice
ExecStart=/usr/lib/harborplay/harbor-progress-agent clipboard
# Exits 0 by itself when the launcher has no harbor.clipboard port.
Restart=on-failure
RestartSec=2
TimeoutStopSec=3
Nice=5
